{
  "name": "taskflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @taskflow/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "typescript": "^5.9.0"
  }
}
