# Másold `.env` néven és töltsd ki; a `.env` soha nem kerülhet a repóba.

# --- API ---
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
# A publikus URL (Origin-ellenőrzés, e-mail linkek), pl. https://taskflow.example.com
APP_URL=
# SQLite fájl; Dockerben a compose fixen /data/taskflow.db-re állítja
DATABASE_URL=
# true: üres adatbázisnál demo tábla jön létre, amit az első regisztrált felhasználó átvesz
SEED=

# --- Csatolmányok ---
# Lokális fájltár (Dockerben a compose a /data/uploads-ra állítja) és a legnagyobb fájlméret MB-ban
UPLOAD_DIR=
MAX_UPLOAD_MB=

# --- Hitelesítés ---
# Legalább 32 véletlen karakter (pl. `openssl rand -base64 48`); élesben kötelező
SESSION_SECRET=
SESSION_TTL_DAYS=
# invite (alap): az első felhasználó (admin) szabadon regisztrálhat, utána csak meghívóval; a meghívó nélküli
# látogató a „csak meghívóval” oldalt látja. open: bárki regisztrálhat – nyilvános oldalon ne használd!
REGISTRATION_MODE=
# Alap: true. Megerősítetlen e-mail-című felhasználó (a platform-admin kivételével) csak a megerősítő oldalt éri el;
# a meghívóval regisztráltak megerősítettnek számítanak. A kikapcsolás (false) csak fejlesztéshez ajánlott.
REQUIRE_EMAIL_VERIFICATION=
# Kérés/perc IP-nként (általános, illetve az érzékeny auth végpontokra) és a fiókzárolás küszöbe
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
LOGIN_MAX_FAILURES=
# Kérés/perc API kulcsonként
API_KEY_RATE_LIMIT_MAX=
# Határidő-emlékeztetők gyakorisága percben (0: kikapcsolva; alapérték: 60)
DUE_REMINDER_INTERVAL_MINUTES=

# Az auditnapló megőrzési ideje napokban (0: örökre megmarad; alapérték: 90)
AUDIT_RETENTION_DAYS=

# --- Webhookok ---
# true: privát/loopback célcímek engedélyezése (csak fejlesztéshez; élesben SSRF-kockázat, hagyd üresen)
WEBHOOK_ALLOW_PRIVATE_TARGETS=

# --- Hangasszisztens (opcionális) ---
# Gemini API kulcs (https://aistudio.google.com); csak a szerveren él, a böngészőhöz nem kerül. Nélküle nincs hangvezérlés.
GEMINI_API_KEY=
# A Live API modellje, a felhasználónkénti egyidejű munkamenetek és a munkamenet maximális hossza (perc)
GEMINI_LIVE_MODEL=
VOICE_MAX_SESSIONS_PER_USER=
VOICE_MAX_MINUTES=

# --- E-mail ---
# console (csak fejlesztés: a levelet a konzolra írja) vagy smtp (élesben kötelező)
MAIL_TRANSPORT=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
# Gmail: SMTP_USER = a Gmail-cím, SMTP_PASS = app password (nem a fiók jelszava)
SMTP_USER=
SMTP_PASS=

# --- Üzemeltetés (docker compose) ---
# Napi mentés (./backups): időzóna, a mentés órája (0-23) és hány napig őrizzük
TZ=
BACKUP_HOUR=
BACKUP_KEEP_DAYS=
# Cloudflare Zero Trust -> Networks -> Tunnels -> a tunnel tokenje
CLOUDFLARE_TUNNEL_TOKEN=
