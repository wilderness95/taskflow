# Másold `.env` néven és töltsd ki; a `.env` soha nem kerülhet a repóba.

# --- API ---
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
# A publikus URL (Origin-ellenőrzés, e-mail linkek), pl. https://taskflow.example.com
APP_URL=
# SQLite fájl; Dockerben a compose fixen /data/taskflow.db-re állítja
DATABASE_URL=
# true: üres adatbázisnál demo tábla jön létre, amit az első regisztrált felhasználó átvesz
SEED=

# --- Hitelesítés ---
# Legalább 32 véletlen karakter (pl. `openssl rand -base64 48`); élesben kötelező
SESSION_SECRET=
SESSION_TTL_DAYS=
# invite: az első felhasználó (admin) szabadon regisztrálhat, utána csak meghívóval; open: bárki
REGISTRATION_MODE=
# Kérés/perc IP-nként (általános, illetve az érzékeny auth végpontokra) és a fiókzárolás küszöbe
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
LOGIN_MAX_FAILURES=

# --- E-mail ---
# console (csak fejlesztés: a levelet a konzolra írja) vagy smtp (élesben kötelező)
MAIL_TRANSPORT=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
# Gmail: SMTP_USER = a Gmail-cím, SMTP_PASS = app password (nem a fiók jelszava)
SMTP_USER=
SMTP_PASS=

# --- Üzemeltetés (docker compose) ---
# Cloudflare Zero Trust -> Networks -> Tunnels -> a tunnel tokenje
CLOUDFLARE_TUNNEL_TOKEN=
