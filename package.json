{
  "name": "taskflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @taskflow/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "prettier": "^3.10.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
