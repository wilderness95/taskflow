{
  "name": "@taskflow/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "openapi:export": "tsx src/openapi/export.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/migrate.ts --seed"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@taskflow/shared": "*",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fractional-indexing": "^4.0.0",
    "nodemailer": "^10.5.0",
    "tsx": "^4.23.15",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  }
}
